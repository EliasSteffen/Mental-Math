{
  "name": "offline-sync",
  "version": "0.1.0",
  "description": "Offline-first Repository (IndexedDB/localStorage) mit Outbox, Merge-Regeln und Hintergrund-Sync; Supabase-Adapter. Framework-frei.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./supabase": {
      "types": "./dist/supabase/index.d.ts",
      "default": "./dist/supabase/index.js"
    },
    "./sql/*": "./sql/*"
  },
  "files": [
    "dist",
    "sql",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@supabase/supabase-js": "2.118.0",
    "fake-indexeddb": "6.2.6"
  }
}
